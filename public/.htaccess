# Настройки Apache для guide.ssau.ru.
# Все блоки обёрнуты в IfModule: если модуля на сервере нет, директива просто
# пропускается, а не роняет сайт с ошибкой 500.

# Один адрес сайта: https://www.guide.ssau.ru → https://guide.ssau.ru.
# Срабатывает только когда сервер видит HTTPS — так редирект не может
# случайно увести посетителя с защищённого соединения на http.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.guide\.ssau\.ru$ [NC]
  RewriteCond %{HTTPS} =on
  RewriteRule ^ https://guide.ssau.ru%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # index.html не кешируем — иначе после обновления студенты увидят старую версию
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # В именах js, css и шрифтов есть хеш — при каждой сборке он новый,
  # поэтому их можно кешировать надолго
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
